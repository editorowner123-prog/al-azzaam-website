{
  "cleanUrls": true,
  "functions": {
    "api/berita.js": { "includeFiles": "berita-page.html" }
  },
  "redirects": [
    { "source": "/berita.html", "destination": "/berita", "permanent": true },
    { "source": "/berita-page", "destination": "/berita", "permanent": true }
  ],
  "rewrites": [
    { "source": "/berita", "destination": "/api/berita" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
